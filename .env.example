# ──────────────────────────────────────────────────────────────────────────────
# Personal AI Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Managed by docker-compose; override here if using external DB
# DATABASE_URL=postgresql+asyncpg://agent:agent@db:5432/agentdb
POSTGRES_PASSWORD=change-me-strong-password

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDeeffGGHHiijjKKLLmmnnOOPP
# Your personal chat ID — get it by messaging @userinfobot
TELEGRAM_OWNER_CHAT_ID=123456789
# Optional: webhook secret for extra security (set any random string)
TELEGRAM_WEBHOOK_SECRET=my-super-secret-webhook-token

# ── Gemini ───────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your-key-here
GEMINI_MODEL=gemini-1.5-pro

# ── Gmail ────────────────────────────────────────────────────────────────────
# Path to OAuth credentials JSON downloaded from Google Cloud Console
# (Gmail API must be enabled, scope: gmail.readonly)
GMAIL_CREDENTIALS_JSON=/secrets/gmail_credentials.json
GMAIL_TOKEN_JSON=/secrets/gmail_token.json
GMAIL_MAX_RESULTS=20

# ── Google Calendar ──────────────────────────────────────────────────────────
# Path to OAuth credentials JSON (can reuse Gmail project, add Calendar scope)
GCAL_CREDENTIALS_JSON=/secrets/gcal_credentials.json
GCAL_TOKEN_JSON=/secrets/gcal_token.json
GCAL_TIMEZONE=Europe/Berlin

# ── Mailcow ──────────────────────────────────────────────────────────────────
# Your Mailcow instance REST API base URL
MAILCOW_API_URL=https://mail.yourdomain.com/api/v1
# API key from Mailcow Admin → Access → API
MAILCOW_API_KEY=your-mailcow-api-key-here
# The mailbox address to read from and send as
MAILCOW_EMAIL_ADDRESS=you@yourdomain.com

# ── Worker intervals ─────────────────────────────────────────────────────────
EMAIL_POLL_INTERVAL_SECONDS=900
ANALYSIS_POLL_INTERVAL_SECONDS=60
NOTIFICATION_POLL_INTERVAL_SECONDS=30

# ── Docker ───────────────────────────────────────────────────────────────────
AGENT_PORT=8000
